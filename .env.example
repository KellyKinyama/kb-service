# Azure AI Foundry (chat model used to generate grounded answers)
AZURE_AI_ENDPOINT=https://aiml4good.services.ai.azure.com/openai/v1
AZURE_AI_DEPLOYMENT=gpt-5.4
AZURE_SPEECH_KEY=<resource-key>

