# Azure AI Foundry (chat model used to generate grounded answers)
AZURE_AI_ENDPOINT=https://aiml4good.services.ai.azure.com/openai/v1
AZURE_AI_DEPLOYMENT=gpt-5.4
AZURE_SPEECH_KEY=<resource-key>

# Local embedding model (downloaded once, runs offline)
# KB_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# KB_DATA_DIR=./kb_data
# KB_CHUNK_SIZE=1000
# KB_CHUNK_OVERLAP=150
# KB_TOP_K=5

# Vector store backend: "numpy" (default, local file) or "dartdb" (dart-db-server)
# KB_VECTOR_BACKEND=numpy
# KB_DARTDB_HOST=127.0.0.1
# KB_DARTDB_PORT=4555
# KB_DARTDB_TABLE=chunks
# KB_DARTDB_INDEX_KIND=hnsw
